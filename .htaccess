# MDI Algiers Business School : configuration Apache (générée par build.py, ne pas modifier à la main)
ErrorDocument 404 /404.html
DirectoryIndex index.html
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/avif .avif
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anciennes adresses (ancien site) : une seule redirection 301 vers l'adresse finale, avant la règle https / sans www.
